# Dictionary for bt_tree_exec_fuzzer: builtin node IDs, port names and
# scripting tokens used by BehaviorTree.CPP XML documents.
#
# XML scaffolding
"<root BTCPP_format=\"4\">"
"<BehaviorTree ID=\"MainTree\">"
"</BehaviorTree>"
"<SubTree ID=\"AuxTree\"/>"
"BTCPP_format="
"ID="
"name="
# control nodes
"<Sequence>"
"</Sequence>"
"<ReactiveSequence>"
"<SequenceWithMemory>"
"<Fallback>"
"<ReactiveFallback>"
"<Parallel success_count=\"1\" failure_count=\"1\">"
"<ParallelAll failure_count=\"1\">"
"<IfThenElse>"
"<WhileDoElse>"
"<Switch2 variable=\"{var}\" case_1=\"1\" case_2=\"2\">"
"<TryCatch catch_on_halt=\"true\">"
# decorators
"<Inverter>"
"<ForceSuccess>"
"<ForceFailure>"
"<KeepRunningUntilFailure>"
"<RunOnce then_skip=\"true\">"
"<Repeat num_cycles=\"2\">"
"<RetryUntilSuccessful num_attempts=\"2\">"
"<Timeout msec=\"20\">"
"<Delay delay_msec=\"5\">"
"<Precondition if=\"var > 0\" else=\"FAILURE\">"
"<LoopInt queue=\"1;2;3\" value=\"{loopv}\" if_empty=\"SUCCESS\">"
# actions / conditions
"<AlwaysSuccess/>"
"<AlwaysFailure/>"
"<Script code=\""
"<ScriptCondition code=\""
"<SetBlackboard output_key=\"var2\" value=\"{var}\"/>"
"<UnsetBlackboard key=\"var2\"/>"
"<Sleep msec=\"3\"/>"
"SUCCESS"
"FAILURE"
"SKIPPED"
# scripting tokens
"var"
"var2"
"loopv"
"dbl"
"str"
"flag"
"txt"
"MODE_A"
"MODE_B"
"{var}"
"{txt}"
"var = var + 1"
"flag = !flag"
"var > 0"
"var < 5"
"str == 'abc'"
"true"
"false"
